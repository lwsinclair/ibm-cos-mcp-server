{
  "name": "@kirtijha/ibm-cos-mcp-server",
  "version": "1.0.0",
  "description": "Production-ready IBM Cloud Object Storage MCP Server with 37 comprehensive tools. Full S3 API compatibility with stdio + HTTP modes for AI assistants, Watsonx Orchestrate, and agent frameworks.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ibm-cos-mcp-server": "dist/index.js",
    "ibm-cos-mcp-http": "dist/http-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SETUP_GUIDE.md"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev:http": "npm run build && npm run start:http"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ibm-cloud",
    "cloud-object-storage",
    "ibm-cos",
    "s3-compatible",
    "object-storage",
    "bucket-management",
    "watsonx-orchestrate",
    "agent-framework",
    "http-server",
    "rest-api",
    "ai-assistant",
    "enterprise-integration"
  ],
  "author": "kirtijha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.ibm.com/kirtijha/ibm-cos-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.ibm.com/kirtijha/ibm-cos-mcp-server/issues"
  },
  "homepage": "https://github.ibm.com/kirtijha/ibm-cos-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "ibm-cos-sdk": "^1.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.1",
    "shx": "^0.3.4",
    "typescript": "^5.7.2"
  }
}
