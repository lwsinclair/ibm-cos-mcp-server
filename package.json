{
  "name": "@kirtijha/ibm-cos-mcp-server",
  "version": "1.0.0",
  "description": "Comprehensive IBM Cloud Object Storage MCP Server with full S3 API compatibility - production-ready implementation for complete object storage management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ibm-cos-connector": "dist/index.js",
    "ibm-cos-http-server": "dist/http-server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start:http": "node dist/http-server.js",
    "dev:http": "npm run build && npm run start:http"
  },
  "keywords": [
    "mcp",
    "ibm",
    "cloud-object-storage",
    "cos",
    "s3",
    "object-storage",
    "ai",
    "claude"
  ],
  "author": "kirtijha",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "ibm-cos-sdk": "^1.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.1",
    "shx": "^0.3.4",
    "typescript": "^5.7.2"
  }
}
